formula:
  created_time: 'date(if(created_at, created_at, file.ctime))'
  modified_time: 'date(if(modified_at, modified_at, file.mtime))'
filters:
  and:
    - categories.contains(link("人物"))
    - '!file.path.startsWith("模板")'
views:
  - type: table
    name: 所有
    order:
      - file.name
      - tags
