formula:
  created_time: 'date(if(created_at, created_at, file.ctime))'
  modified_time: 'date(if(modified_at, modified_at, file.mtime))'
filters:
  and:
    - '!file.hasProperty("journal_type")'
    - or:
      - or:
        - and:
          - formula.created_time.date() >= date(this.journal_start_date)
          - formula.created_time.date() <= date(this.journal_end_date)
        - and:
          - formula.modified_time.date() >= date(this.journal_start_date)
          - formula.modified_time.date() <= date(this.journal_end_date)
      - or:
        - file.name.contains(this.file.name)
        - file.links.contains(this.file)
properties:
  note.categories:
    displayName: 类别
  note.tags:
    displayName: 标签
  formula.created_time:
    displayName: 创建时间
  file.mtime:
    displayName: 修改时间
views:
  - type: table
    name: 所有
    order:
      - file.name
      - categories
      - tags
      - formula.created_time
      - formula.modified_time
    sort:
      - property: formula.created_time
        direction: DESC
      - property: formula.modified_time
        direction: DESC
  - type: table
    name: 新建
    filter:
      and:
        - formula.created_time >= date(this.journal_start_date)
        - formula.created_time <= date(this.journal_end_date)
    order:
      - file.name
      - categories
      - tags
      - formula.created_time
      - formula.modified_time
    sort:
      - property: formula.created_time
        direction: DESC
      - property: formula.modified_time
        direction: DESC
  - type: table
    name: 修改
    filter:
      and:
        - formula.modified_time >= date(this.journal_start_date)
        - formula.modified_time <= date(this.journal_end_date)
    order:
      - file.name
      - categories
      - tags
      - formula.modified_time
      - formula.created_time
    sort:
      - property: formula.modified_time
        direction: DESC
      - property: formula.created_time
        direction: DESC
