formula:
  created_time: 'date(if(created_at, created_at, file.ctime))'
  modified_time: 'date(if(modified_at, modified_at, file.mtime))'
filters:
  and:
    - categories.contains(link("剪报"))
    - '!file.path.startsWith("模板")'
properties:
  note.author:
    displayName: 作者
  formula.created_time:
    displayName: 摘录时间
  note.published_at:
    displayName: 发布时间
views:
  - type: table
    name: 所有
    order:
      - file.name
      - author
      - published_at
      - formula.created_time
    sort:
      - property: formula.created_time
        direction: DESC
