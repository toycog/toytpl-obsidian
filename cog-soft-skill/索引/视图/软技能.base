filters:
  and:
    - categories.contains(link("软技能"))
    - '!file.path.startsWith("模板")'
properties:
  file.ctime:
    displayName: 创建时间
views:
  - type: table
    name: 所有
  - type: table
    name: 学习
    filters:
      and:
        - file.tags.contains("话题/学习")
    order:
      - file.name
      - file.ctime
    sort:
      - property: file.ctime
        direction: DESC
  - type: table
    name: 目标管理
    filters:
      and:
        - file.tags.contains("话题/目标管理")
    order:
      - file.name
      - file.ctime
    sort:
      - property: file.ctime
        direction: DESC
  - type: table
    name: 项目计划
    filters:
      and:
        - file.tags.contains("话题/计划管理")
    order:
      - file.name
      - file.ctime
    sort:
      - property: file.ctime
        direction: DESC
  - type: table
    name: 复盘
    filters:
      and:
        - file.tags.contains("话题/复盘")
    order:
      - file.name
      - file.ctime
    sort:
      - property: file.ctime
        direction: DESC
  - type: table
    name: 自我认知
    filters:
      and:
        - file.tags.contains("话题/自我认知")
    order:
      - file.name
      - file.ctime
    sort:
      - property: file.ctime
        direction: DESC
  - type: table
    name: 团队建设
    filters:
      and:
        - file.tags.contains("话题/团队建设")
    order:
      - file.name
      - file.ctime
    sort:
      - property: file.ctime
        direction: DESC
